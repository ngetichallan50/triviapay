# Supabase — copy to `.env.local` and fill in if you use a different project.
# The defaults in src/lib/config.ts already point at the TriviaPay project,
# so these are only needed to override them (e.g. a staging database).
NEXT_PUBLIC_SUPABASE_URL=https://zhqzztsvetkvqbgnogjl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_8OCauT4cR1zH1HK2iX7wtg_dZ0WdyiU

# ── Paywave Express (SERVER-SIDE ONLY) ──────────────────────────────────────
# Paywave docs: https://paywavexpress.co.ke/documentation
# Do NOT prefix any of these with NEXT_PUBLIC_ — the API key must never reach
# the browser. The app calls Paywave from its own /api/pay/* route handlers.
PAYWAVE_BASE_URL=https://paywavexpress.co.ke
PAYWAVE_API_KEY=
PAYWAVE_EMAIL=
# Only for Paybill accounts — leave blank for a Till Number.
PAYWAVE_ACCOUNT_NUMBER=

# ── Supabase service role (SERVER-SIDE ONLY) ────────────────────────────────
# Needed so the SERVER can switch Premium on after Paywave confirms a payment.
# Without it the browser would have to write profiles.premium itself, which any
# user could fake. Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=
